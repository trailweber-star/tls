# Copy to .env and fill in. Without DATABASE_URL the API runs in demo
# mode against src/data/mock.js — the whole site works, nothing is saved.

PORT=4000
SITE_URL=http://localhost:5173

# ------------------------------------------------------------------ #
# Database — required for anything to be stored
#
# Local:  postgresql://USER@localhost:5432/tls
# Neon / Supabase / RDS: paste the connection string they give you.
# Set DATABASE_SSL=no-verify only if your provider needs it.
# ------------------------------------------------------------------ #
DATABASE_URL=
# DATABASE_SSL=
# DATABASE_POOL_MAX=10

# Signs every login token. Generate with: openssl rand -base64 48
# Without it the server boots with a throwaway key and every restart
# logs everybody out.
AUTH_SECRET=

# Seeded admin account (npm run seed). Change the password on first
# login, or set these before seeding.
# SEED_ADMIN_EMAIL=admin@toplocalspecialists.com
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NAME=

# ------------------------------------------------------------------ #
# Everything below is optional. Each one is fully implemented and
# waiting only for credentials — see the lib/ file named in brackets.
# ------------------------------------------------------------------ #

# ------------------------------------------------------------------ #
# Email  [lib/mailer.js]
#
# Approvals, rejections with their reason, claim decisions, enquiry
# alerts, receipts. Until one of the blocks below is filled in, every
# message is written to the server log instead of being sent, and the
# admin dashboard says "Not connected" rather than showing a green tick.
#
# Pick ONE provider. Whichever set of keys is present wins; set
# MAIL_PROVIDER to force a particular one when several are.
#
# Check it works:  npm run mail:test -- you@yourdomain.com
# Or prove the plumbing with no account at all:  npm run mail:test -- --local
# ------------------------------------------------------------------ #

# The address every message comes from. Use a domain you control and
# have set SPF and DKIM records for — without them a fair share of what
# you send goes to spam whatever provider you use.
# MAIL_FROM="Top Local Specialists <no-reply@toplocalspecialists.com>"
# MAIL_REPLY_TO=admin@toplocalspecialists.com
# MAIL_BCC=archive@toplocalspecialists.com

# Resend — simplest to set up (resend.com)
# RESEND_API_KEY=re_...

# Postmark — best deliverability for transactional mail
# POSTMARK_SERVER_TOKEN=
# POSTMARK_STREAM=outbound

# SendGrid
# SENDGRID_API_KEY=

# Mailgun
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=mg.toplocalspecialists.com
# MAILGUN_REGION=eu

# Any SMTP host — Gmail, Microsoft 365, Zoho, Fastmail, IONOS, SES SMTP.
# Port 465 is implicit TLS, 587 upgrades with STARTTLS.
# SMTP_HOST=smtp.zoho.eu
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=

# Staging guards — so a real provider can be pointed at a copy of the
# live database without emailing a single real clinician.
# MAIL_REDIRECT_TO=you@yourdomain.com     every message goes here instead
# MAIL_ALLOWLIST=@toplocalspecialists.com  anything else is skipped
# MAIL_ALLOW_EXAMPLE=1                     send to @example.com anyway
# MAIL_PROVIDER=console                    log everything, send nothing

SUPPORT_EMAIL=admin@toplocalspecialists.com

# ------------------------------------------------------------------ #
# Payments  [lib/payments.js, lib/paymentProviders.js]
#
# Both keys or neither. With only the secret key set, payments stay
# simulated on purpose: a payment that cannot be confirmed by a verified
# webhook would charge a member and never switch their plan on.
#
# The webhook secret comes from the Stripe dashboard when you add the
# endpoint:  https://api.yourdomain.com/api/billing/webhook
# Send it these events: checkout.session.completed,
# invoice.payment_succeeded, invoice.payment_failed,
# customer.subscription.deleted
# ------------------------------------------------------------------ #
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
#
# Optional: use real Stripe Prices instead of an ad-hoc charge, which
# makes Stripe handle renewals and failed-payment retries.
# STRIPE_PRICE_PREMIUM_MONTHLY=price_...
# STRIPE_PRICE_PREMIUM_YEARLY=price_...
# STRIPE_PRICE_CLINWELL_MONTHLY=price_...
# STRIPE_PRICE_CLINWELL_YEARLY=price_...
# PAYMENT_PROVIDER=none          keep checkout simulated even with keys set

# Addresses and maps  [lib/geocoders.js, lib/maps.js]
#
# Both work with no key at all: postcodes.io answers address lookups and
# OpenStreetMap draws the maps, free and without an account. One key
# upgrades both at once — address suggestions become Google Places, and
# every map on the site becomes a Google map. Nothing else changes.
#
# Restrict the key by HTTP referrer in the Google Cloud console before
# going live. A Maps Embed key is visible to anyone who views the page —
# that is how the API works — and the referrer restriction is what stops
# somebody else's site spending your quota. Enable "Maps Embed API" and
# "Places API" on the project.
# GEOCODER_PROVIDER=postcodes
# GOOGLE_MAPS_API_KEY=

# Admin desktop notifications  [lib/push.js, lib/pushProvider.js]
#
# A new application or claim raises a notification on the admin's
# machine instead of waiting to be noticed. No account and no supplier:
# web push is a browser standard and the keys are a pair you generate.
#
#   npx web-push generate-vapid-keys
#
# Paste both below and restart. The public key is served to the browser
# on purpose — it is how a subscription is tied to this server, and it
# grants nothing on its own. The private key is the half that matters.
# With only one of the two set, push stays off rather than half-working.
#
# Check the delivery path without a browser:  npm run push:test
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@toplocalspecialists.com

# ClinWell.ai — the client's own service  [lib/clinwell.js]
# CLINWELL_API_BASE_URL=
# CLINWELL_API_KEY=
# CLINWELL_SSO_SECRET=

# How long an application waits before the admin is reminded, and how
# often the sweep runs.  [lib/reminders.js]
# APPROVAL_REMINDER_HOURS=24
# APPROVAL_SWEEP_MINUTES=30

# Uploaded images  [lib/storage.js, lib/maps.js]
#
# Where this API is reachable from a browser. Uploaded photos are served
# by this server but rendered by a page on the frontend's origin, so the
# URLs handed out have to be absolute. In development the request's own
# origin is used and this can stay unset; in production set it to the
# API's public address or every photo on the site 404s.
# PUBLIC_API_URL=https://api.toplocalspecialists.com
#
# Largest image a member may upload, in MB. Default 5.
# MAX_UPLOAD_MB=5
#
# Local disk is the default store. It does not survive a deploy or a
# restart on a host with no persistent disk attached (Render's web
# services have none by default) — and behind more than one instance,
# files written to one machine are invisible to the next either way.
# Set CLOUDINARY_URL to move uploads off local disk; see lib/storage.js
# for the S3 / R2 seam if Cloudinary is ever not the answer.
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
#
# Largest video an eligible member may upload, in MB. Default 64 — a
# minute of phone footage is comfortably 30-60MB, so a smaller cap
# refuses every real recording. The bytes are buffered in memory on the
# way through, so this is a real ceiling, not a formality.
# MAX_VIDEO_MB=64

# ------------------------------------------------------------------
# ClinWell.ai — contract v1.0.1
#
# Four kinds of value, and mixing them up is the usual way this
# integration fails silently.
#
# Nothing here is required. With none of it set, events queue but are
# never sent, the clinical panels read "not connected", and no enquiry
# leaves this server. That is the correct state until staging exists.
#
# Do not build against production (§2). Credentials arrive by one-time
# link from a password manager and never over chat or email.
# ------------------------------------------------------------------
#
# Where ClinWell is. Staging until they sign staging off.
# CLINWELL_BASE_URL=https://staging.api.clinwell.ai
#
# 1. THEIR key, for OUR reads (§4.2 workspace status, §4.4 availability).
#    Sent as Authorization: Bearer.
# CLINWELL_PARTNER_KEY=
#
# 2. The webhook secret we SIGN outbound events and enquiries with
#    (tls-signature, Appendix A). PREVIOUS exists only so a rotation can
#    be verified from both sides; signing always uses the current one.
# CLINWELL_WEBHOOK_SECRET=
# CLINWELL_WEBHOOK_SECRET_PREVIOUS=
#
# 3. OUR key, which WE issue to ClinWell, presented on the inbound badge
#    push (Appendix B). Bearer keys rotate by coordinated cutover, not
#    in pairs — §3 — so there is deliberately no _PREVIOUS here.
# CLINWELL_INBOUND_KEY=
#
# 4. The secret ClinWell signs that push with (clinwell-signature). This
#    one IS dual-valued, so their rotation needs no downtime on our side.
# CLINWELL_INBOUND_SECRET=
# CLINWELL_INBOUND_SECRET_PREVIOUS=
#
# Forwarding patient enquiries to ClinWell (§4.3) needs BOTH of the next
# two, and the second is not a formality. It is the reference for the
# processor terms in the ClinWell-to-TLS agreement, and until it exists
# there is no published basis for sending a patient's contact details to
# a processor. A feature flag is not a lawful basis, so the switch alone
# does nothing.
# CLINWELL_ENQUIRY_FORWARDING=false
# CLINWELL_PROCESSOR_TERMS_REF=
#
# Set to none to keep the seam disconnected even with a base URL present.
# CLINWELL_PROVIDER=none
#
# How often the outbox drains, in seconds. Default 60.
# CLINWELL_SWEEP_SECONDS=60
#
# Per-attempt timeout in ms. Default 15000. A timeout is a retry, not a
# failure — the retry ladder is fixed by §4.1 and is not configurable.
# CLINWELL_TIMEOUT_MS=15000
